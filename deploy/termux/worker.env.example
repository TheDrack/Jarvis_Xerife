# Local worker identity only. Never put provider keys or user passwords here.
JARVIS_MINI_AGENT_ENABLED=true
JARVIS_MINI_AGENT_WORKERS=1
JARVIS_AGENT_ID=jarvis-termux-mini-1
JARVIS_AGENT_ENVIRONMENT=termux-android
JARVIS_AGENT_REMOTE_INFERENCE=true
JARVIS_AGENT_REMOTE_INFERENCE_TIMEOUT=55
JARVIS_TASK_QUEUE_API_URL=https://jarvis-api-c47i.onrender.com
JARVIS_TASK_QUEUE_LEASE_SECONDS=90
# Local objective persistence: the phone keeps objective progress across restarts.
JARVIS_OBJECTIVE_JOURNAL_ENABLED=true
JARVIS_OBJECTIVE_JOURNAL_PATH=/data/data/com.termux/files/home/jarvis-mobile/state/agent-objectives.sqlite3
# Provisioned token is injected locally by jarvis-worker configure; do not commit it.
JARVIS_TASK_QUEUE_WORKER_TOKEN_JARVIS_TERMUX_MINI_1=

# Optional local OpenAI-compatible provider (e.g. Gemini, Qwen or xAI).
# Set JARVIS_AGENT_REMOTE_INFERENCE=false and provision the same model_provider server-side.
# JARVIS_AGENT_MODEL_PROVIDER=gemini
# FREELLMAPI_API_KEY=<vendor-api-key>
# FREELLMAPI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# FREELLMAPI_MODEL=gemini-model-id

# Multiple agents can use different provider APIs concurrently. Provision one
# unique worker token per generated agent ID and set matching trusted model_provider
# values with manage_agent_worker_credentials.py --model-provider.
# Example for two agents (base ID has no trailing slot number):
# JARVIS_AGENT_ID=jarvis-termux-mini
# JARVIS_MINI_AGENT_WORKERS=2
# JARVIS_TASK_QUEUE_WORKER_TOKEN_JARVIS_TERMUX_MINI_1=<token-for-agent-1>
# JARVIS_AGENT_REMOTE_INFERENCE_JARVIS_TERMUX_MINI_1=false
# JARVIS_AGENT_MODEL_PROVIDER_JARVIS_TERMUX_MINI_1=gemini
# FREELLMAPI_API_KEY_JARVIS_TERMUX_MINI_1=<gemini-api-key>
# FREELLMAPI_BASE_URL_JARVIS_TERMUX_MINI_1=https://generativelanguage.googleapis.com/v1beta
# FREELLMAPI_MODEL_JARVIS_TERMUX_MINI_1=<gemini-model-id>
# JARVIS_TASK_QUEUE_WORKER_TOKEN_JARVIS_TERMUX_MINI_2=<token-for-agent-2>
# JARVIS_AGENT_REMOTE_INFERENCE_JARVIS_TERMUX_MINI_2=false
# JARVIS_AGENT_MODEL_PROVIDER_JARVIS_TERMUX_MINI_2=xai
# FREELLMAPI_API_KEY_JARVIS_TERMUX_MINI_2=<xai-api-key>
# FREELLMAPI_BASE_URL_JARVIS_TERMUX_MINI_2=https://api.x.ai/v1
# FREELLMAPI_MODEL_JARVIS_TERMUX_MINI_2=<grok-model-id>

# Optional consumer-app session as a local inference provider (after AccessibilityService is enabled).
# Provision the same trusted model_provider on the server credential record first:
# python scripts/manage_agent_worker_credentials.py set-provider --agent-id jarvis-termux-mini-1 --model-provider android_app:claude
# JARVIS_AGENT_REMOTE_INFERENCE_JARVIS_TERMUX_MINI_1=false
# JARVIS_AGENT_MODEL_PROVIDER_JARVIS_TERMUX_MINI_1=android_app:claude
