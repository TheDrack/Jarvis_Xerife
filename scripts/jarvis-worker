#!/data/data/com.termux/files/usr/bin/bash
set -Eeuo pipefail
PREFIX="${PREFIX:-/data/data/com.termux/files/usr}"
HOME="${HOME:-/data/data/com.termux/files/home}"
ENV_FILE="${JARVIS_WORKER_ENV_FILE:-$HOME/.config/jarvis/agent-worker/worker.env}"
SERVICE="$PREFIX/var/service/jarvis-agent-worker"
STATUS_FILE="$HOME/jarvis-mobile/state/agent-worker.status"
LOG_FILE="$HOME/jarvis-mobile/logs/agent-worker/current"

load_config() {
    [ -f "$ENV_FILE" ] || return 1
    set -a
    . "$ENV_FILE"
    set +a
}

configured_worker_ids() {
    local base="${JARVIS_AGENT_ID:-jarvis-termux-mini-1}"
    local count="${JARVIS_MINI_AGENT_WORKERS:-1}" prefix index
    [[ "$count" =~ ^[0-9]+$ ]] || count=1
    (( count < 1 )) && count=1
    (( count > 8 )) && count=8
    if (( count == 1 )); then printf '%s\n' "$base"; return; fi
    prefix="$(printf '%s' "$base" | sed -E 's/[0-9]+$//; s/[-_.]+$//')"
    [ -n "$prefix" ] || prefix="$base"
    for ((index=1; index<=count; index++)); do printf '%s-%d\n' "$prefix" "$index"; done
}

missing_config() {
    local missing=() count agent normalized token_var token remote_var remote
    local provider_var provider api_key_var base_url_var model_var api_key base_url model
    count="${JARVIS_MINI_AGENT_WORKERS:-1}"
    [[ "$count" =~ ^[0-9]+$ ]] || count=1
    (( count < 1 )) && count=1
    (( count > 8 )) && count=8
    [ "${JARVIS_MINI_AGENT_ENABLED:-false}" = "true" ] || missing+=("JARVIS_MINI_AGENT_ENABLED=true")
    [ -n "${JARVIS_TASK_QUEUE_API_URL:-}" ] || missing+=("JARVIS_TASK_QUEUE_API_URL")
    while IFS= read -r agent; do
        normalized="$(printf '%s' "$agent" | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z0-9]/_/g; s/^_*//; s/_*$//')"
        token_var="JARVIS_TASK_QUEUE_WORKER_TOKEN_${normalized}"
        token="${!token_var:-}"
        if (( count == 1 )); then token="${token:-${JARVIS_TASK_QUEUE_WORKER_TOKEN:-}}"; fi
        [ -n "$token" ] || missing+=("$token_var")
        remote_var="JARVIS_AGENT_REMOTE_INFERENCE_${normalized}"
        remote="${!remote_var:-${JARVIS_AGENT_REMOTE_INFERENCE:-false}}"
        [ "$remote" = "true" ] && continue
        provider_var="JARVIS_AGENT_MODEL_PROVIDER_${normalized}"
        provider="${!provider_var:-${JARVIS_AGENT_MODEL_PROVIDER:-}}"
        api_key_var="FREELLMAPI_API_KEY_${normalized}"
        base_url_var="FREELLMAPI_BASE_URL_${normalized}"
        model_var="FREELLMAPI_MODEL_${normalized}"
        api_key="${!api_key_var:-${FREELLMAPI_API_KEY:-}}"
        base_url="${!base_url_var:-${FREELLMAPI_BASE_URL:-}}"
        model="${!model_var:-${FREELLMAPI_MODEL:-}}"
        case "$provider" in
            openai|gemini|xai|qwen)
                [ -n "$api_key" ] || missing+=("$api_key_var")
                [ -n "$base_url" ] || missing+=("$base_url_var")
                [ -n "$model" ] && [ "$model" != "auto" ] || missing+=("$model_var (explicit model ID required)")
                ;;
            groq)
                groq_var="GROQ_API_KEY_${normalized}"
                [ -n "$api_key" ] || [ -n "${!groq_var:-${GROQ_API_KEY:-}}" ] || missing+=("FREELLMAPI_API_KEY or $groq_var")
                ;;
            venice)
                venice_var="VENICE_API_KEY_${normalized}"
                [ -n "$api_key" ] || [ -n "${!venice_var:-${VENICE_API_KEY:-}}" ] || missing+=("FREELLMAPI_API_KEY or $venice_var")
                ;;
            freellmapi)
                [ -n "$api_key" ] || missing+=("$api_key_var")
                ;;
            *)
                groq_var="GROQ_API_KEY_${normalized}"
                venice_var="VENICE_API_KEY_${normalized}"
                [ -n "$api_key" ] || [ -n "${!groq_var:-${GROQ_API_KEY:-}}" ] || [ -n "${!venice_var:-${VENICE_API_KEY:-}}" ] || missing+=("FREELLMAPI_API_KEY or GROQ_API_KEY or VENICE_API_KEY")
                ;;
        esac
    done < <(configured_worker_ids)
    printf '%s\n' "${missing[@]}"
}

configure() {
    local api_url agent_id worker_token normalized token_var tmp
    mkdir -p "$(dirname "$ENV_FILE")"
    load_config || true
    api_url="${JARVIS_TASK_QUEUE_API_URL:-https://jarvis-api-c47i.onrender.com}"
    read -r -p "URL da API [$api_url]: " value || true
    [ -n "${value:-}" ] && api_url="$value"
    agent_id="${JARVIS_AGENT_ID:-jarvis-termux-mini-1}"
    read -r -p "ID do agente [$agent_id]: " value || true
    [ -n "${value:-}" ] && agent_id="$value"
    normalized="$(printf '%s' "$agent_id" | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z0-9]/_/g; s/^_*//; s/_*$//')"
    token_var="JARVIS_TASK_QUEUE_WORKER_TOKEN_${normalized}"
    worker_token="${!token_var:-}"
    if [ -z "$worker_token" ]; then
        read -r -s -p "Token individual do worker ($token_var): " worker_token; echo
    else
        read -r -s -p "Novo token individual (Enter preserva o atual): " replacement_token; echo
        [ -n "${replacement_token:-}" ] && worker_token="$replacement_token"
        unset replacement_token
    fi
    if [ -z "$worker_token" ]; then
        echo "Token individual do worker ausente; configuracao cancelada." >&2
        return 2
    fi
    tmp="$(mktemp "$(dirname "$ENV_FILE")/.worker.env.XXXXXX")"
    umask 077
    {
        printf 'JARVIS_MINI_AGENT_ENABLED=true\nJARVIS_MINI_AGENT_WORKERS=1\n'
        printf 'JARVIS_AGENT_ID=%q\n' "$agent_id"
        printf 'JARVIS_AGENT_ENVIRONMENT=termux-android\nJARVIS_AGENT_REMOTE_INFERENCE=true\nJARVIS_AGENT_REMOTE_INFERENCE_TIMEOUT=55\n'
        printf 'JARVIS_TASK_QUEUE_API_URL=%q\n' "$api_url"
        printf '%s=%q\n' "$token_var" "$worker_token"
        printf 'JARVIS_TASK_QUEUE_LEASE_SECONDS=90\n'
        printf 'JARVIS_OBJECTIVE_JOURNAL_ENABLED=true\nJARVIS_OBJECTIVE_JOURNAL_PATH=%q\n' "$HOME/jarvis-mobile/state/agent-objectives.sqlite3"
    } > "$tmp"
    chmod 600 "$tmp"
    mv -f "$tmp" "$ENV_FILE"
    unset worker_token
    echo "Configuracao remota gravada com permissao 600; nenhum segredo de provedor ou JWT foi solicitado."
    start_service
}



start_service() {
    if ! load_config; then echo "Configuração ausente. Execute: jarvis-worker configure" >&2; return 2; fi
    local missing
    missing="$(missing_config)"
    if [ -n "$missing" ]; then
        echo "Worker BLOQUEADO; faltam:"; printf ' - %s\n' "$missing"; return 2
    fi
    rm -f "$SERVICE/down"
    "$PREFIX/bin/sv" up "$SERVICE"
    "$PREFIX/bin/sv" status "$SERVICE"
}

case "${1:-status}" in
    configure) configure ;;
    start) start_service ;;
    boot-start)
        if load_config && [ -z "$(missing_config)" ]; then
            rm -f "$SERVICE/down"
            "$PREFIX/bin/sv" up "$SERVICE" >/dev/null 2>&1 || true
            "$PREFIX/bin/sv" status "$SERVICE"
        else
            touch "$SERVICE/down"
            "$PREFIX/bin/sv" down "$SERVICE" >/dev/null 2>&1 || true
            echo "[BOOT] Worker não iniciado: configuração/credenciais ainda ausentes."
        fi
        ;;
    stop) touch "$SERVICE/down"; "$PREFIX/bin/sv" down "$SERVICE"; "$PREFIX/bin/sv" status "$SERVICE" ;;
    restart) load_config || { echo "Configuração ausente."; exit 2; }; [ -z "$(missing_config)" ] || { echo "Configuração incompleta."; exit 2; }; rm -f "$SERVICE/down"; "$PREFIX/bin/sv" restart "$SERVICE"; "$PREFIX/bin/sv" status "$SERVICE" ;;
    status)
        "$PREFIX/bin/sv" status "$SERVICE" 2>&1 || true
        if [ -f "$STATUS_FILE" ]; then cat "$STATUS_FILE"; else echo "Estado do worker ainda não publicado."; fi
        ;;
    logs) [ -f "$LOG_FILE" ] && tail -n 100 -F "$LOG_FILE" || echo "Log ainda não criado." ;;
    objectives|prune-objectives)
        repo_root="${JARVIS_REPO_ROOT:-$HOME/Jarvis_Xerife_repo}"
        journal="${JARVIS_OBJECTIVE_JOURNAL_PATH:-$HOME/jarvis-mobile/state/agent-objectives.sqlite3}"
        if [ ! -f "$journal" ]; then
            echo "Nenhum objetivo persistido ainda em $journal."
            exit 0
        fi
        args=(--status)
        [ "$1" = "prune-objectives" ] && args+=(--prune)
        PYTHONPATH="$repo_root${PYTHONPATH:+:$PYTHONPATH}" \
            "$PREFIX/bin/python" -m app.multiagent.objective_journal --path "$journal" "${args[@]}"
        ;;
    provision-help)
        echo "Em ambiente administrativo confiável, com DATABASE_URL/JARVIS_TASK_QUEUE_DATABASE_URL apontando ao PostgreSQL compartilhado:"
        echo 'PROVIDER_ID=gemini  # use the same provider configured for this worker'
        echo 'python scripts/manage_agent_worker_credentials.py issue --agent-id jarvis-termux-mini-1 --capability text_reasoning --model-provider "$PROVIDER_ID"'
        echo "Escolha o mesmo provider_id configurado no worker. O token aparece uma única vez; não o envie por chat."
        ;;
    *) echo "Uso: jarvis-worker {configure|start|stop|restart|status|logs|objectives|prune-objectives|provision-help}" >&2; exit 2 ;;
esac
