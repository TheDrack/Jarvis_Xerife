# Jarvis Assistant Configuration
# Copy this file to .env and customize as needed

# Application Settings
APP_NAME=Jarvis Assistant
VERSION=1.0.0

# User Settings (configured by setup wizard)
USER_ID=
ASSISTANT_NAME=

# Voice Recognition Settings
LANGUAGE=pt-BR
WAKE_WORD=xerife

# Audio Settings
AMBIENT_NOISE_ADJUSTMENT=true

# PyAutoGUI Settings
PYAUTOGUI_PAUSE=0.4
SEARCH_TIMEOUT=7.5

# LLM Settings (Google Gemini)
GOOGLE_API_KEY=your_google_api_key_here
# Also accepted as GEMINI_API_KEY (same key, used by MetabolismCore fleet)
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

GEMINI_MODEL=gemini-1.5-pro

# LLM Settings (Venice AI; optional provider, never replaces Groq/Gemini defaults)
# Create/manage keys at https://venice.ai/settings/api
VENICE_API_KEY=
VENICE_MODEL=venice-uncensored-1-2
VENICE_BASE_URL=https://api.venice.ai/api/v1

# Optional: use Venice directly for the FreeLLMAPI mini-agent client
# Set FREELLMAPI_API_KEY to the same key value as VENICE_API_KEY (not a variable reference)
# FREELLMAPI_BASE_URL=https://api.venice.ai/api/v1
# FREELLMAPI_MODEL=venice-uncensored-1-2
# FREELLMAPI_TIMEOUT_SECONDS=45

# LLM Settings (Groq) - Gears System (Sistema de Marchas)
GROQ_API_KEY=
# High Gear (Marcha Alta): Default model for fast, cost-effective processing
GROQ_MODEL=llama-3.3-70b-versatile
# Low Gear (Marcha Baixa): Fallback model for rate limit situations (optional)
GROQ_LOW_GEAR_MODEL=llama-3.1-8b-instant

# LLM Settings (Respan Gateway) - open-source gateway in-process, opt-in
# Reuses the provider keys above (GROQ_API_KEY, GEMINI_API_KEY, ...); no Respan
# account, credits or tracing needed. See docs/RESPAN_GATEWAY.md
RESPAN_GATEWAY_ENABLED=false
# Model requested from the gateway. Empty = groq/<GROQ_MODEL>
RESPAN_MODEL=
# Optional: path to an existing gateway.toml (routes, extra providers, client keys)
# RESPAN_GATEWAY_CONFIG=./gateway.toml

# Security Settings
# Required for JWT signing. Generate a unique secret: openssl rand -hex 32
# Leave blank until you configure it; authentication fails closed without a secure value.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Local Bridge Security (Meta 59-60)
# API key for local agent authentication
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY_LOCAL=your_local_bridge_api_key_here

# Database Settings
# For local development with SQLite (default):
# DATABASE_URL=sqlite:///jarvis.db
# For PostgreSQL (Supabase or production):
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Example Supabase URL format:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# API Server Settings
API_HOST=0.0.0.0
# PORT is the standard environment variable used by Render and other cloud platforms
# For local development, you can use either PORT or API_PORT
PORT=8000
# API_PORT=8000  # Alternative for backward compatibility

# Worker Settings
WORKER_POLL_INTERVAL=2

# OSINT Settings (Eagle OSINT - Eagle Eye Protocol)
EAGLE_OSINT_API_KEY=

# Telegram Settings
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# OpenRouter - modelos gratuitos (deepseek-r1, qwen-72b). Chave em: https://openrouter.ai
OPENROUTER_API_KEY=

# LLM Settings (Mistral AI)
# Get your key at: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=

# PostgreSQL Docker Compose Settings (required when using docker-compose)
# Generate a unique password; do not use a shared/default credential.
# POSTGRES_USER=jarvis
# POSTGRES_PASSWORD=
# POSTGRES_DB=jarvis_db

# Supabase Settings (optional - enables cloud auth, storage, and vector queries)
# Get from: https://supabase.com/dashboard/project/<project>/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# Provider identity advertised by the FreeLLMAPI mini-agent runtime.
# Set to venice only when FREELLMAPI_BASE_URL/API_KEY/MODEL actually target Venice.
FREELLMAPI_PROVIDER=unknown

# Optional supervised mini-agent worker (disabled unless explicitly enabled).
JARVIS_MINI_AGENT_ENABLED=false
JARVIS_TASK_QUEUE_API_URL=https://jarvis-api-c47i.onrender.com
# Configure one auth mode: API token OR username/password. Keep secrets out of git.
# JARVIS_TASK_QUEUE_API_TOKEN=
# JARVIS_TASK_QUEUE_USERNAME=
# JARVIS_TASK_QUEUE_PASSWORD=
JARVIS_AGENT_ID=mini-freellmapi-1
JARVIS_TASK_QUEUE_LEASE_SECONDS=90

# Respan observability (set locally; never commit API keys)
# RESPAN_API_KEY=
# RESPAN_BASE_URL=https://api.respan.ai/api
