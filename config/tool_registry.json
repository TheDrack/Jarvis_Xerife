{
      "version": "1.0.0",
      "adapter_id": "prospecting_adapter",
      "provider": "Receita Federal - Dados Abertos do CNPJ",
      "origin": "first_party",
      "permissions": ["prospecting.cnpj.read"],
      "allowed_scopes": ["local", "prospecting:read"],
      "execution_mode": "read_only",
      "trust_level": "system",
      "data_classification": "public",
      "rate_limit": {
        "requests": 6,
        "window_seconds": 60
      },
      "timeout_seconds": 30,
      "cost_units": 1,
      "idempotency": "not_applicable",
      "license": "Receita Federal CNPJ open data; CC-BY attribution required",
      "terms_uri": "https://www.gov.br/receitafederal/pt-br/acesso-a-informacao/dados-abertos/cadastros/cnpj",
      "tool_id": "prospecting.companies.search",
      "description": "Search active or inactive Brazilian companies by state, municipality and CNAE in the materialized official CNPJ dataset. Results are grouped by the 8-digit CNPJ root.",
      "operation": "search_companies",
      "capabilities": ["prospecting.cnpj.read"],
      "input_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "uf": {
            "type": "string",
            "pattern": "^[A-Z]{2}$"
          },
          "cnae_prefixes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "pattern": "^[0-9]{2,7}$"
            }
          },
          "municipalities": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "only_active": {
            "type": "boolean",
            "default": true
          },
          "include_secondary_cnae": {
            "type": "boolean",
            "default": true
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "after_cnpj_basico": {
            "type": "string",
            "pattern": "^[0-9]{8}$"
          },
            "establishment_types": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "type": "string",
                "enum": [
                  "1",
                  "2"
                ]
              }
            },
            "situation_codes": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "string",
                "pattern": "^[0-9]{2}$"
              }
            },
            "neighborhoods": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "postal_codes": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "pattern": "^[0-9.-]{5,10}$"
              }
            },
            "company_sizes": {
              "type": "array",
              "maxItems": 10,
              "items": {
                "type": "string",
                "enum": [
                  "01",
                  "03",
                  "05"
                ]
              }
            },
            "legal_natures": {
              "type": "array",
              "maxItems": 100,
              "items": {
                "type": "string",
                "pattern": "^[0-9]{4}$"
              }
            },
            "opened_from": {
              "type": "string",
              "pattern": "^\\d{8}$"
            },
            "opened_to": {
              "type": "string",
              "pattern": "^\\d{8}$"
            },
            "capital_min": {
              "type": "number",
              "minimum": 0
            },
            "capital_max": {
              "type": "number",
              "minimum": 0
            },
            "simples_only": {
              "type": "boolean",
              "default": false
            },
            "mei_only": {
              "type": "boolean",
              "default": false
            },
            "country_codes": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "maxLength": 3
              }
            },
            "reason_codes": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "pattern": "^[0-9]{2}$"
              }
            },
            "special_situation_codes": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "maxLength": 100
              }
            },
            "has_phone": {
              "type": "boolean"
            },
            "has_email": {
              "type": "boolean"
            },
            "has_fax": {
              "type": "boolean"
            }},
        "additionalProperties": false,
        "required": ["uf", "cnae_prefixes"]
      },
      "output_schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "source_id": {
            "type": "string"
          },
          "identity_granularity": {
            "type": "string",
            "const": "cnpj_basico"
          },
          "identity_note": {
            "type": "string"
          },
          "companies": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "company_name": {
                  "type": "string"
                },
                "legal_name": {
                  "type": ["string", "null"]
                },
                "cnpj": {
                  "type": ["string", "null"],
                  "pattern": "^[0-9]{14}$"
                },
                "website": {
                  "type": ["string", "null"]
                },
                "industry": {
                  "type": ["string", "null"]
                },
                "segment": {
                  "type": ["string", "null"]
                },
                "employee_count": {
                  "type": ["integer", "null"]
                },
                "city": {
                  "type": ["string", "null"]
                },
                "state": {
                  "type": ["string", "null"]
                },
                "country": {
                  "type": "string"
                },
                "registry_presence": {
                  "type": ["string", "null"]
                },
                "evidence": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": true
                  }
                },
                    "company_size": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "legal_nature": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "capital_social": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "opening_date": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^[0-9]{8}$"
                    },
                    "establishment_type": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "neighborhood": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "postal_code": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "primary_cnae": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "has_phone": {
